<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport"
    content="width=device-width, initial-scale=1" />
  <meta name="robots"
    content="noindex, nofollow" />
  <title>Stefan's Creative Bots | Admin Dashboard</title>
  <script>
    document.documentElement.setAttribute("data-bs-theme", window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  </script>
  <link rel="stylesheet"
    href="/styles/main.css" />
  <style>
    body {
      padding: 1rem;
    }

    table {
      max-width: 100rem;
    }

    .mention {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      min-width: 20rem;
    }

    textarea {
      width: 100%;
      min-width: 16rem;
      min-height: 4rem;
      box-sizing: border-box;
    }

    tbody tr {
      cursor: pointer;
    }

    .btn:disabled {
      cursor: not-allowed;
      pointer-events: auto;
    }

    .actions button {
      margin: 0 0.25rem 0.25rem 0;
    }
  </style>
</head>

<body>
  <h1 class="mb-4">Mentions and quotes</h1>
  <p>
    Last checked:
    {{#if last_checked_at}}<time id="last-checked"
      datetime="{{last_checked_at}}"></time>{{else}}waiting for the first check to finish{{/if}}
  </p>
  <p>
    <button class="clear-bulk btn btn-outline-danger"
      data-scope="responded"
      {{#unless
      responded_count}}disabled{{/unless}}>Clear mentions with a response ({{responded_count}})</button>
    <button class="clear-bulk btn btn-outline-danger"
      id="clear-selected"
      data-scope="selected"
      disabled>Clear selected mentions (0)</button>
  </p>
  {{#if mentions.length}}
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th><input type="checkbox"
            class="form-check-input"
            id="select-all"
            aria-label="Select all mentions" /></th>
        <th>Bot</th>
        <th>From</th>
        <th>Mention</th>
        <th>Reply</th>
        <th>Actions</th>
        <th>Responded</th>
      </tr>
    </thead>
    <tbody class="align-top">
      {{#each mentions}}
      <tr data-id="{{this.id}}">
        <td><input type="checkbox"
            class="select-mention form-check-input"
            aria-label="Select mention" /></td>
        <td>{{this.bot_name}}</td>
        <td>{{this.from_display_name}}<br /><small>{{this.from_acct}}</small></td>
        <td class="mention">{{#if this.spoiler_text}}[CW: {{this.spoiler_text}}]
          {{/if}}{{this.content}}<br /><small>{{this.mentioned_at}}{{#if this.status_url}} · <a
              href="{{this.status_url}}"
              target="_blank"
              rel="noopener noreferrer">open</a>{{/if}}</small></td>
        <td><textarea class="form-control form-control-sm"
            aria-label="Reply text"></textarea></td>
        <td class="actions">
          <button class="btn btn-sm btn-primary"
            data-action="reply">Reply</button>
          <button class="btn btn-sm btn-outline-secondary"
            data-action="boost">Boost</button>
          <button class="btn btn-sm btn-outline-secondary"
            data-action="like">Like</button>
          <button class="btn btn-sm btn-outline-danger"
            data-action="clear">Clear</button>
        </td>
        <td>{{#if this.responded}}Yes{{else}}No{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p>No mentions.</p>
  {{/if}}

  <script>
    const lastChecked = document.getElementById("last-checked");

    if (lastChecked) {
      const relativeTime = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
      const checkedAt = new Date(lastChecked.getAttribute("datetime")).getTime();

      lastChecked.title = new Date(checkedAt).toLocaleString("en-US", {
        timeZone: "America/New_York",
        timeZoneName: "short"
      });

      const updateLastChecked = () => {
        const seconds = Math.max(0, Math.round((Date.now() - checkedAt) / 1000));

        if (seconds < 60) {
          lastChecked.textContent = relativeTime.format(-seconds, "second");
        } else if (seconds < 3600) {
          lastChecked.textContent = relativeTime.format(-Math.floor(seconds / 60), "minute");
        } else {
          lastChecked.textContent = relativeTime.format(-Math.floor(seconds / 3600), "hour");
        }
      };

      updateLastChecked();
      setInterval(updateLastChecked, 1000);
    }

    const confirmations = {
      reply: "Send this reply?",
      boost: "Boost this post?",
      like: "Like this post?",
      clear: "Clear this mention?"
    };

    const confirmClear = (message) => {
      const answer = prompt(`${message}\n\nType CLEAR to confirm.`);
      const confirmed = answer !== null && answer.trim().toLowerCase() === "clear";

      if (answer !== null && !confirmed) {
        alert("Text didn't match, nothing was cleared.");
      }

      return confirmed;
    };

    const send = async (url, body) => {
      const resp = await fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body || {})
      });
      const data = await resp.json();

      if (!resp.ok) {
        alert(`Failed: ${data.error}`);
      }

      return resp.ok;
    };

    document.querySelectorAll("tr[data-id] button").forEach((button) => {
      button.addEventListener("click", async () => {
        const row = button.closest("tr");
        const action = button.dataset.action;
        const text = row.querySelector("textarea").value;

        if (action === "reply" && !text.trim()) {
          alert("Reply text is empty.");
        } else if (action === "clear" ? confirmClear(confirmations[action]) : confirm(confirmations[action])) {
          const succeeded = await send(`/admin/dashboard/${action}`, { id: row.dataset.id, text });

          if (succeeded && action !== "clear" && confirm("Clear this mention now?")) {
            await send("/admin/dashboard/clear", { id: row.dataset.id });
          }

          if (succeeded) {
            location.reload();
          }
        }
      });
    });

    const bulkConfirmations = {
      responded: "Clear all mentions with a response?",
      selected: "Clear the selected mentions?"
    };

    const getSelectedIds = () =>
      [...document.querySelectorAll(".select-mention:checked")].map((checkbox) => checkbox.closest("tr").dataset.id);

    const updateSelectedButton = () => {
      const count = getSelectedIds().length;
      const button = document.getElementById("clear-selected");
      button.textContent = `Clear selected mentions (${count})`;
      button.disabled = count === 0;
    };

    document.querySelectorAll(".select-mention").forEach((checkbox) => {
      checkbox.addEventListener("change", updateSelectedButton);

      checkbox.closest("tr").addEventListener("click", (ev) => {
        const clickedControl = ev.target.closest("a, button, textarea, input");
        const hasSelectedText = window.getSelection().toString() !== "";

        if (!clickedControl && !hasSelectedText) {
          checkbox.checked = !checkbox.checked;
          updateSelectedButton();
        }
      });
    });

    const selectAll = document.getElementById("select-all");

    if (selectAll) {
      selectAll.addEventListener("change", () => {
        document.querySelectorAll(".select-mention").forEach((checkbox) => {
          checkbox.checked = selectAll.checked;
        });
        updateSelectedButton();
      });
    }

    document.querySelectorAll(".clear-bulk").forEach((button) => {
      button.addEventListener("click", async () => {
        const scope = button.dataset.scope;

        if (confirmClear(bulkConfirmations[scope])) {
          const resp = await fetch(`/admin/dashboard/clear-${scope}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ids: scope === "selected" ? getSelectedIds() : [] })
          });
          const data = await resp.json();

          if (resp.ok) {
            location.reload();
          } else {
            alert(`Failed: ${data.error}`);
          }
        }
      });
    });
  </script>
</body>

</html>