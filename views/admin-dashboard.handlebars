<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport"
    content="width=device-width, initial-scale=1" />
  <meta name="robots"
    content="noindex, nofollow" />
  <title>Stefan's Creative Bots | Admin Dashboard</title>
  <script>
    document.documentElement.setAttribute("data-bs-theme", window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  </script>
  <link rel="stylesheet"
    href="/styles/main.css" />
  <link rel="stylesheet"
    href="/styles/admin-dashboard.css" />
</head>

<body>
  <h1 class="mb-4">Mentions and quotes</h1>
  <p>
    Last checked:
    {{#if last_checked_at}}<time id="last-checked"
      datetime="{{last_checked_at}}"></time>{{else}}waiting for the first check to finish{{/if}}
  </p>
  <p class="d-flex flex-wrap gap-2">
    <button class="clear-bulk btn btn-outline-danger"
      data-scope="responded"
      {{#unless
      responded_count}}disabled{{/unless}}>Clear mentions with a response ({{responded_count}})</button>
    <button class="clear-bulk btn btn-outline-danger"
      id="clear-selected"
      data-scope="selected"
      disabled>Clear selected mentions (0)</button>
  </p>
  {{#if mentions.length}}
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th><input type="checkbox"
            class="form-check-input"
            id="select-all"
            aria-label="Select all mentions" /></th>
        <th>Bot</th>
        <th>From</th>
        <th>Mention</th>
        <th>Reply</th>
        <th>Responded</th>
      </tr>
    </thead>
    <tbody class="align-top">
      {{#each mentions}}
      <tr data-id="{{this.id}}"
        data-bot="{{this.bot_name}}"
        data-from="{{this.from_acct}}">
        <td><input type="checkbox"
            class="select-mention form-check-input"
            aria-label="Select mention" /></td>
        <td data-label="Bot">{{this.bot_name}}</td>
        <td data-label="From">{{this.from_display_name}}<br /><small
            class="text-body-secondary">@{{this.from_acct}}</small></td>
        <td class="mention"
          data-label="Mention">{{#if this.spoiler_text}}[CW: {{this.spoiler_text}}]
          {{/if}}<span class="mention-text">{{this.content}}</span><br /><small class="text-body-secondary">{{#if
            this.status_url}}<a class="text-reset"
              href="{{this.status_url}}"
              target="_blank"
              rel="noopener noreferrer">{{this.mentioned_at}}</a>{{else}}{{this.mentioned_at}}{{/if}} ·
            {{this.visibility}}</small>
          <div class="actions mt-2">
            <button class="btn btn-sm btn-outline-secondary"
              data-action="boost">Boost</button>
            <button class="btn btn-sm btn-outline-secondary"
              data-action="like">Like</button>
            <button class="btn btn-sm btn-outline-secondary"
              data-action="boost-like">Boost + Like</button>
            <button class="btn btn-sm btn-outline-danger"
              data-action="clear">Clear</button>
          </div>
        </td>
        <td data-label="Reply"><textarea class="form-control form-control-sm"
            rows="6"
            aria-label="Reply text"></textarea>
          <button class="btn btn-sm btn-primary mt-2"
            data-action="reply">Reply</button>
        </td>
        <td data-label="Responded">{{#if this.responded}}Yes{{else}}No{{/if}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p>No mentions.</p>
  {{/if}}

  <script src="/scripts/admin-dashboard.js"></script>
</body>

</html>